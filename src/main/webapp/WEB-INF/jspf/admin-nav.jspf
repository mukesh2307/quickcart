<c:set var="adminPath" value="${not empty requestScope['jakarta.servlet.forward.servlet_path'] ? requestScope['jakarta.servlet.forward.servlet_path'] : pageContext.request.servletPath}"/>
<header class="topbar admin-topbar">
  <a class="brand" href="${pageContext.request.contextPath}/admin/dashboard"><span class="brand-mark">Q</span> quick<span>cart</span><span class="admin-label">ADMIN</span></a>
  <nav class="admin-nav" aria-label="Admin navigation">
    <a class="${adminPath eq '/admin/dashboard' ? 'is-active' : ''}"
       href="${pageContext.request.contextPath}/admin/dashboard"
       ${adminPath eq '/admin/dashboard' ? 'aria-current="page"' : ''}><span class="admin-nav-icon" aria-hidden="true">▦</span>Dashboard</a>
    <a class="${adminPath eq '/admin/inventory' ? 'is-active' : ''}"
       href="${pageContext.request.contextPath}/admin/inventory"
       ${adminPath eq '/admin/inventory' ? 'aria-current="page"' : ''}><span class="admin-nav-icon" aria-hidden="true">▤</span>Inventory</a>
    <a class="${adminPath eq '/admin/orders' ? 'is-active' : ''}"
       href="${pageContext.request.contextPath}/admin/orders"
       ${adminPath eq '/admin/orders' ? 'aria-current="page"' : ''}><span class="admin-nav-icon" aria-hidden="true">▣</span>Orders</a>
    <a class="${adminPath eq '/admin/popular-items' ? 'is-active' : ''}"
       href="${pageContext.request.contextPath}/admin/popular-items"
       ${adminPath eq '/admin/popular-items' ? 'aria-current="page"' : ''}><span class="admin-nav-icon" aria-hidden="true">★</span>Frequently bought</a>
    <a class="${adminPath eq '/admin/order-history' ? 'is-active' : ''}"
       href="${pageContext.request.contextPath}/admin/order-history"
       ${adminPath eq '/admin/order-history' ? 'aria-current="page"' : ''}><span class="admin-nav-icon" aria-hidden="true">↺</span>Order history</a>
  </nav>
  <form method="post" action="${pageContext.request.contextPath}/admin/logout">
    <input type="hidden" name="csrfToken" value="<c:out value='${sessionScope.adminCsrfToken}'/>">
    <button class="admin-logout" type="submit">Log out</button>
  </form>
</header>
